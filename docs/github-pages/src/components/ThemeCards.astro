---
// Theme previews in fixed-aspect cards: tall CV screenshots are cropped from the top.
interface Item {
  title: string;
  description: string;
  image: string;
  href: string;
  alt: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ul class="cards">
  {
    items.map((item) => (
      <li>
        <a href={item.href}>
          <div class="shot">
            <img src={item.image} alt={item.alt} loading="lazy" width="800" height="600" />
          </div>
          <strong>{item.title}</strong>
          <span>{item.description}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .cards {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  li {
    margin: 0;
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    text-decoration: none;
  }
  a:hover {
    border-color: var(--sl-color-accent);
  }
  .shot {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.4rem;
    border: 1px solid var(--sl-color-hairline);
    margin-bottom: 0.5rem;
    background: #fff;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  strong {
    color: var(--sl-color-white);
  }
  span {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
</style>
